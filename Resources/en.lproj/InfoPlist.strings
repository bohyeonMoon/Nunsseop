"NSAppleEventsUsageDescription" = "Shows what Music, Spotify and your browsers are playing and controls playback. Also types your messages into agent sessions in Terminal and iTerm2, and opens conversations in new tabs of iTerm2 and Ghostty.";
"NSCalendarsFullAccessUsageDescription" = "Shows today's and this week's events on the notch's Home tab.";
"NSRemindersFullAccessUsageDescription" = "Shows reminders due today under the calendar and lets you complete them.";
"NSCameraUsageDescription" = "Shows your camera in the notch's Mirror tab. Nothing is recorded or sent.";
"NSDesktopFolderUsageDescription" = "Watches for new screenshots so they can be added to the shelf.";
"NSDownloadsFolderUsageDescription" = "Shows when downloads start and finish.";
"NSMicrophoneUsageDescription" = "Records microphone audio with a screen recording when you turn that on in Settings.";
"NSAudioCaptureUsageDescription" = "Changes the volume of individual apps when you turn on per-app volume. Audio is only passed through at the level you choose; nothing is recorded or saved.";
